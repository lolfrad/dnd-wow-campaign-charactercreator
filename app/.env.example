# Optional: override the public project settings in src/data/cloud.json.
# Pages and npm run dev:cloud use those settings by default.
# Supply both values together for another Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Only for a separate traditional Node API; Supabase/Pages does not need this.
VITE_API_BASE_URL=

# GitHub Actions sets this from the repository's Pages configuration.
# For a manual project-site build: /dnd-wow-campaign-charactercreator/
VITE_BASE_PATH=/

# Never put a service-role key, database password or SMTP password in VITE_*.
