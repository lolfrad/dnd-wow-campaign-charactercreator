# Optional when the frontend and API are hosted separately (e.g. GitHub Pages).
# Must use HTTPS in production. No trailing slash. Changes require a new build.
VITE_API_BASE_URL=https://your-model-api.example.com

# GitHub Actions sets this from the repository's Pages configuration.
# For a manual project-site build: /dnd-wow-campaign-charactercreator/
VITE_BASE_PATH=/

# Supabase is planned, not connected yet. These public client values will be
# added when authentication, RLS and cloud saving are implemented.
# Never put a service-role key, database password or SMTP password in VITE_*.
